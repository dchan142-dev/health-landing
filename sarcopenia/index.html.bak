<!DOCTYPE html>
<html lang="zh-HK">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Health Decoder｜肌少症與消瘦專題 · 從源頭除錯</title>
  <style>


    /* ==========================================================================
       Health-Decoder.com 全站統一設計規範 (Design System v5.0 - Bento Grid)
       標準：WCAG 2.1 AA 無障礙規範 | 2026 DTC Bento Grid 模組化佈局
       ========================================================================== */
    :root {
      --color-primary: #0F172A;
      --color-primary-dark: #020617;
      --color-primary-light: #F1F5F9;
      --color-accent: #0D9488;
      --color-accent-hover: #0F766E;
      --color-accent-light: #CCFBF1;
      --color-accent-text: #115E59;
      
      --color-wa: #25D366;
      --color-wa-hover: #1EBE5D;
      
      --color-danger: #EF4444;
      --color-danger-bg: #FEF2F2;
      --color-warning: #F59E0B;
      --color-warning-bg: #FFFBEB;
      
      --color-text-main: #1E293B;
      --color-text-muted: #475569;
      --color-text-sub: #64748B;
      
      --color-bg: #F8FAFC;
      --color-surface: #FFFFFF;
      --color-border: #E2E8F0;
      
      --font-stack: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Noto Sans TC", "Microsoft JhengHei", sans-serif;
      --radius-sm: 8px;
      --radius-md: 12px;
      --radius-lg: 16px;
      --radius-xl: 24px;
      
      --shadow-sm: 0 2px 8px rgba(15, 23, 42, 0.04);
      --shadow-md: 0 6px 18px rgba(15, 23, 42, 0.06);
      --shadow-lg: 0 12px 30px rgba(15, 23, 42, 0.09);
    }


    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }


    html {
      scroll-behavior: smooth;
    }


    body {
      font-family: var(--font-stack);
      font-size: 19px;
      line-height: 1.75;
      color: var(--color-text-main);
      background-color: var(--color-bg);
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      padding-bottom: 80px;
    }


    /* === 導航列 === */
    .navbar {
      background: var(--color-surface);
      border-bottom: 1px solid var(--color-border);
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: 0 2px 8px rgba(15, 23, 42, 0.03);
    }


    .nav-container {
      max-width: 1080px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 20px;
    }


    .nav-brand {
      font-size: 20px;
      font-weight: 800;
      color: var(--color-primary);
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 8px;
      letter-spacing: -0.3px;
    }


    .nav-brand span {
      color: var(--color-accent);
    }


    .nav-links {
      display: flex;
      gap: 20px;
      list-style: none;
      align-items: center;
    }


    .nav-links a {
      color: var(--color-text-muted);
      text-decoration: none;
      font-size: 16px;
      font-weight: 600;
      transition: color 0.2s ease;
      padding: 6px 8px;
    }


    .nav-links a:hover {
      color: var(--color-accent);
    }


    .nav-links a.active {
      color: var(--color-primary);
      font-weight: 700;
      border-bottom: 2px solid var(--color-accent);
    }


    /* === 主版面容器 === */
    .container {
      width: 100%;
      max-width: 980px;
      margin: 24px auto;
      padding: 0 20px;
    }


    .section-card {
      background: var(--color-surface);
      border-radius: var(--radius-xl);
      padding: 36px 32px;
      box-shadow: var(--shadow-md);
      border: 1px solid var(--color-border);
      margin-bottom: 36px;
    }


    /* === 排版階梯 === */
    h1 {
      font-size: 32px;
      line-height: 1.35;
      font-weight: 800;
      color: var(--color-primary);
      margin-bottom: 16px;
      letter-spacing: -0.5px;
    }


    h2 {
      font-size: 24px;
      line-height: 1.4;
      font-weight: 800;
      color: var(--color-primary);
      margin: 32px 0 16px 0;
      display: flex;
      align-items: center;
      gap: 10px;
    }


    h3 {
      font-size: 20px;
      line-height: 1.45;
      font-weight: 700;
      color: var(--color-primary);
      margin-bottom: 10px;
    }


    h4 {
      font-size: 18px;
      font-weight: 700;
      color: var(--color-primary);
      margin-bottom: 8px;
    }


    p {
      font-size: 18px;
      line-height: 1.75;
      color: var(--color-text-main);
      margin-bottom: 16px;
    }


    .badge-tag {
      display: inline-flex;
      align-items: center;
      background: var(--color-accent-light);
      color: var(--color-accent-text);
      font-size: 14px;
      font-weight: 700;
      padding: 5px 14px;
      border-radius: 999px;
      margin-bottom: 14px;
      line-height: 1.3;
    }


    .badge-danger {
      background: #FEE2E2;
      color: #991B1B;
    }


    .badge-warning {
      background: #FEF3C7;
      color: #92400E;
    }


    /* === Bento Grid 便當盒佈局體系 === */
    .bento-grid {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      gap: 18px;
      margin: 24px 0;
    }


    .bento-card {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      padding: 26px;
      box-shadow: var(--shadow-sm);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }


    .bento-card:hover {
      border-color: #99F6E4;
      box-shadow: var(--shadow-md);
      transform: translateY(-2px);
    }


    .bento-card.card-large {
      grid-column: span 12;
      background: linear-gradient(135deg, #F0FDFA 0%, #FFFFFF 100%);
      border: 2px solid #5EEAD4;
    }


    .bento-col-12 { grid-column: span 12; }
    .bento-col-8  { grid-column: span 8; }
    .bento-col-6  { grid-column: span 6; }
    .bento-col-4  { grid-column: span 4; }


    .stat-number {
      font-size: 36px;
      font-weight: 800;
      color: var(--color-accent);
      line-height: 1.1;
      margin-bottom: 4px;
    }


    /* === 雙模組佈局標準 (Media Placeholder + Mechanism Text) === */
    .dual-module-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      margin: 22px 0;
      align-items: stretch;
    }


    .media-placeholder-box {
      background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%);
      border-radius: var(--radius-lg);
      padding: 24px;
      color: #FFFFFF;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      min-height: 240px;
      border: 1px solid #334155;
      box-shadow: inset 0 2px 10px rgba(0,0,0,0.3);
    }


    .media-placeholder-box .icon-play {
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background: rgba(13, 148, 136, 0.9);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      margin-bottom: 14px;
      box-shadow: 0 4px 14px rgba(13, 148, 136, 0.5);
    }


    .media-placeholder-box .media-title {
      font-size: 17px;
      font-weight: 700;
      margin-bottom: 6px;
      color: #F8FAFC;
    }


    .media-placeholder-box .media-sub {
      font-size: 13px;
      color: #94A3B8;
    }


    .content-explain-box {
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      padding: 24px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }


    /* === 按鈕體系 (Touch Target >= 52px) === */
    .btn, .btn-primary, .btn-secondary, .btn-whatsapp, .btn-outline {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      min-height: 52px;
      font-size: 18px;
      font-weight: 700;
      border-radius: var(--radius-md);
      text-decoration: none;
      cursor: pointer;
      border: none;
      padding: 12px 24px;
      text-align: center;
      transition: all 0.2s ease;
      line-height: 1.3;
      gap: 8px;
    }


    .btn-primary {
      background: var(--color-accent);
      color: #FFFFFF;
      box-shadow: 0 4px 14px rgba(13, 148, 136, 0.3);
    }


    .btn-primary:hover {
      background: var(--color-accent-hover);
      transform: translateY(-1px);
      box-shadow: 0 6px 18px rgba(13, 148, 136, 0.4);
    }


    .btn-secondary {
      background: var(--color-primary);
      color: #FFFFFF;
    }


    .btn-secondary:hover {
      background: var(--color-primary-dark);
      transform: translateY(-1px);
    }


    .btn-outline {
      background: #FFFFFF;
      color: var(--color-primary);
      border: 2px solid var(--color-border);
    }


    .btn-outline:hover {
      border-color: var(--color-primary);
      background: var(--color-primary-light);
    }


    .btn-whatsapp {
      background: var(--color-wa);
      color: #FFFFFF;
      box-shadow: 0 4px 14px rgba(37, 211, 102, 0.3);
    }


    .btn-whatsapp:hover {
      background: var(--color-wa-hover);
      box-shadow: 0 6px 18px rgba(37, 211, 102, 0.4);
    }


    /* === 自測問卷 UI (Block B) === */
    .quiz-group {
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      padding: 22px;
      margin-bottom: 22px;
    }


    .quiz-group-header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 16px;
      border-bottom: 1px solid var(--color-border);
      padding-bottom: 12px;
    }


    .quiz-num {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      background: var(--color-accent-light);
      color: var(--color-accent-text);
      font-weight: 800;
      font-size: 15px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }


    .quiz-title {
      font-size: 17px;
      font-weight: 800;
      color: var(--color-primary);
      margin: 0;
    }


    .options-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 10px;
    }


    .option-label {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      background: #FFFFFF;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      padding: 14px 16px;
      cursor: pointer;
      font-size: 16px;
      line-height: 1.5;
      transition: all 0.2s ease;
    }


    .option-label:hover {
      border-color: var(--color-accent);
      background: #F0FDFA;
    }


    .option-label input[type="radio"],
    .option-label input[type="checkbox"] {
      margin-top: 3px;
      width: 18px;
      height: 18px;
      accent-color: var(--color-accent);
      flex-shrink: 0;
    }


    .option-label.none-opt {
      background: #F1F5F9;
      font-weight: 600;
      color: #475569;
    }


    .user-info-grid {
      display: grid;
      grid-template-columns: 1fr 1fr 2fr;
      gap: 14px;
      margin-bottom: 20px;
    }


    .input-field {
      width: 100%;
      padding: 12px 14px;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      font-size: 16px;
      background: #FFFFFF;
      color: var(--color-text-main);
    }


    /* === 診斷結果區 (Block C) === */
    .diagnosis-highlight-card {
      background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%);
      color: #FFFFFF;
      border-radius: var(--radius-lg);
      padding: 28px;
      margin-bottom: 24px;
      border: 1px solid #334155;
    }


    .fear-quote-box {
      background: #FEF2F2;
      border-left: 5px solid var(--color-danger);
      border-radius: var(--radius-sm);
      padding: 18px 20px;
      color: #991B1B;
      font-size: 17px;
      font-weight: 700;
      line-height: 1.6;
      margin: 20px 0;
    }


    .warning-gold-box {
      background: #FFFBEB;
      border-left: 5px solid var(--color-warning);
      border-radius: var(--radius-sm);
      padding: 18px 20px;
      color: #92400E;
      font-size: 16px;
      font-weight: 600;
      line-height: 1.6;
      margin: 20px 0;
    }


    /* 佔比進度條 */
    .ratio-bar-wrap {
      margin-bottom: 12px;
    }


    .ratio-info {
      display: flex;
      justify-content: space-between;
      font-size: 14px;
      font-weight: 700;
      margin-bottom: 4px;
      color: #334155;
    }


    .ratio-bar-bg {
      width: 100%;
      height: 10px;
      background: #E2E8F0;
      border-radius: 5px;
      overflow: hidden;
    }


    .ratio-bar-fill {
      height: 100%;
      border-radius: 5px;
      transition: width 0.8s ease-in-out;
    }


    .c1-bar { background: #0284C7; }
    .c2-bar { background: #F59E0B; }
    .c3-bar { background: #8B5CF6; }
    .c4-bar { background: #10B981; }
    .c5-bar { background: #EF4444; }


    /* === 產品展示與彈窗 (Block G) === */
    .product-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 18px;
      margin: 20px 0;
    }


    .product-card {
      background: #FFFFFF;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      padding: 20px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      box-shadow: var(--shadow-sm);
    }


    .product-card:hover {
      border-color: var(--color-accent);
      box-shadow: var(--shadow-md);
    }


    .product-card h4 {
      font-size: 17px;
      color: var(--color-primary);
      margin-bottom: 6px;
    }


    .product-price {
      font-size: 20px;
      font-weight: 800;
      color: var(--color-accent);
      margin: 8px 0;
    }


    /* === 套裝與結算區 (Block H) === */
    .bundle-deal-card {
      background: linear-gradient(135deg, #F0FDFA 0%, #FFFFFF 100%);
      border: 2px solid var(--color-accent);
      border-radius: var(--radius-xl);
      padding: 28px;
      margin: 24px 0;
      position: relative;
      box-shadow: var(--shadow-md);
    }


    .discount-pill {
      position: absolute;
      top: -14px;
      right: 24px;
      background: var(--color-danger);
      color: #FFFFFF;
      font-size: 14px;
      font-weight: 800;
      padding: 4px 16px;
      border-radius: 999px;
      box-shadow: 0 2px 8px rgba(239, 68, 68, 0.4);
    }


    .bundle-pricing {
      display: flex;
      align-items: baseline;
      gap: 14px;
      margin: 14px 0;
      flex-wrap: wrap;
    }


    .price-original {
      font-size: 17px;
      color: var(--color-text-sub);
      text-decoration: line-through;
    }


    .price-sale {
      font-size: 30px;
      font-weight: 800;
      color: var(--color-accent);
    }


    .price-save {
      background: #CCFBF1;
      color: #115E59;
      font-size: 14px;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 6px;
    }


    /* 表格樣式 */
    .table-wrap {
      overflow-x: auto;
      margin: 20px 0;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
    }


    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }


    th, td {
      padding: 14px 16px;
      border-bottom: 1px solid var(--color-border);
      font-size: 16px;
    }


    th {
      background: var(--color-primary-light);
      color: var(--color-primary);
      font-weight: 700;
    }


    .qty-btn {
      width: 32px;
      height: 32px;
      border: 1px solid var(--color-border);
      background: #FFFFFF;
      border-radius: 6px;
      cursor: pointer;
      font-weight: bold;
      font-size: 16px;
    }


    .qty-inp {
      width: 44px;
      height: 32px;
      text-align: center;
      border: 1px solid var(--color-border);
      border-radius: 6px;
      font-size: 16px;
    }


    /* 結算表單 */
    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin: 20px 0;
    }


    .form-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }


    .form-group.full {
      grid-column: span 2;
    }


    .form-group label {
      font-size: 15px;
      font-weight: 700;
      color: var(--color-text-main);
    }


    /* 購物車彙總 */
    .cart-summary-box {
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      padding: 24px;
      margin: 24px 0;
    }


    .cart-row {
      display: flex;
      justify-content: space-between;
      font-size: 16px;
      margin-bottom: 10px;
    }


    .cart-total-row {
      display: flex;
      justify-content: space-between;
      font-size: 22px;
      font-weight: 800;
      color: var(--color-primary);
      border-top: 2px dashed var(--color-border);
      padding-top: 14px;
      margin-top: 14px;
    }


    /* 見證卡片 (Block J) */
    .testimonial-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin: 20px 0;
    }


    .testimonial-card {
      background: #F8FAFC;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      padding: 22px;
    }


    .testimonial-header {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 10px;
    }


    .testimonial-avatar {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: var(--color-accent-light);
      color: var(--color-accent-text);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 16px;
    }


    /* 浮動按鈕 (Block K) */
    .floating-back-top {
      position: fixed;
      bottom: 24px;
      right: 24px;
      width: 52px;
      height: 52px;
      border-radius: 50%;
      background: var(--color-primary);
      color: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      font-weight: bold;
      text-decoration: none;
      box-shadow: 0 4px 14px rgba(0,0,0,0.3);
      z-index: 999;
      transition: all 0.2s ease;
      cursor: pointer;
      border: none;
    }


    .floating-back-top:hover {
      background: var(--color-accent);
      transform: translateY(-2px);
    }


    /* 模態彈窗 Modal */
    .modal-overlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(15, 23, 42, 0.65);
      z-index: 1000;
      align-items: center;
      justify-content: center;
      padding: 20px;
      backdrop-filter: blur(4px);
    }


    .modal-card {
      background: #FFFFFF;
      max-width: 600px;
      width: 100%;
      border-radius: var(--radius-xl);
      padding: 30px;
      position: relative;
      max-height: 85vh;
      overflow-y: auto;
      box-shadow: var(--shadow-lg);
    }


    .modal-close {
      position: absolute;
      top: 18px;
      right: 18px;
      background: none;
      border: none;
      font-size: 24px;
      cursor: pointer;
      color: var(--color-text-muted);
    }


    /* RWD */
    @media (max-width: 768px) {
      .bento-col-12, .bento-col-8, .bento-col-6, .bento-col-4 {
        grid-column: span 12;
      }
      .dual-module-grid, .user-info-grid, .form-grid, .testimonial-grid {
        grid-template-columns: 1fr;
      }
      .section-card {
        padding: 24px 18px;
      }
      h1 { font-size: 26px; }
      h2 { font-size: 22px; }
    }
  
    /* === v6 追加專屬高質感微調 === */
    .hero-trust-box {
      background: var(--color-surface);
      border-left: 4px solid var(--color-accent);
      border-top: 1px solid var(--color-border);
      border-right: 1px solid var(--color-border);
      border-bottom: 1px solid var(--color-border);
      border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
      padding: 18px 20px;
      margin: 20px auto 0 auto;
      max-width: 620px;
      text-align: left;
    }
    .hero-trust-name { font-size: 18px; font-weight: 800; color: var(--color-primary); }
    .hero-trust-tag { font-size: 15px; font-weight: 700; color: var(--color-accent-text); margin-top: 2px; }
    .hero-trust-desc { font-size: 15px; color: var(--color-text-muted); margin-top: 4px; line-height: 1.6; }
    .hero-trust-url { font-size: 13px; color: var(--color-text-sub); margin-top: 4px; font-weight: 500; }

    /* Block G 單鍵高質感卡片 (僅保留 Pop-up B) */
    .product-single-card {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      padding: 18px 20px;
      margin-bottom: 14px;
      box-shadow: var(--shadow-sm);
    }
    .p-card-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 8px;
      gap: 12px;
    }
    .p-card-name {
      font-size: 17.5px;
      font-weight: 800;
      color: var(--color-primary);
      flex: 1;
    }
    .p-card-desc {
      font-size: 15px;
      color: var(--color-text-muted);
      line-height: 1.55;
    }
    .btn-more-b {
      background: var(--color-accent-light);
      color: var(--color-accent-text);
      border: 1.5px solid var(--color-accent);
      padding: 8px 16px;
      font-size: 14px;
      font-weight: 800;
      border-radius: var(--radius-sm);
      cursor: pointer;
      flex-shrink: 0;
      transition: all 0.2s ease;
    }
    .btn-more-b:hover { background: var(--color-accent); color: #FFF; }

    /* Block H 單品選購行 (產品名稱 + 價格 + 產品詳情按鍵 + 數量調節) */
    .h-single-item-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 14px 16px;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      margin-bottom: 10px;
      box-shadow: var(--shadow-sm);
      gap: 12px;
    }
    .h-item-info {
      flex: 1;
      display: flex;
      align-items: baseline;
      gap: 10px;
      flex-wrap: wrap;
    }
    .h-item-title {
      font-weight: 700;
      font-size: 16px;
      color: var(--color-primary);
    }
    .h-item-price {
      color: var(--color-accent-text);
      font-weight: 800;
      font-size: 15px;
    }
    .btn-detail-h {
      background: var(--color-primary);
      color: #FFF;
      padding: 6px 12px;
      font-size: 13px;
      font-weight: 700;
      border-radius: var(--radius-sm);
      border: none;
      cursor: pointer;
      flex-shrink: 0;
      transition: background 0.2s ease;
    }
    .btn-detail-h:hover { background: var(--color-primary-dark); }

    .h-bundle-card {
      background: var(--color-surface);
      border: 2px solid var(--color-accent);
      border-radius: var(--radius-lg);
      padding: 18px 20px;
      margin-bottom: 14px;
      box-shadow: var(--shadow-md);
    }
    .qty-control { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
    .qty-btn {
      width: 32px;
      height: 32px;
      border: 1px solid var(--color-border);
      background: var(--color-bg);
      border-radius: var(--radius-sm);
      font-weight: bold;
      cursor: pointer;
      font-size: 16px;
    }
    .qty-val { font-size: 16px; font-weight: 800; width: 24px; text-align: center; }

    /* 購物車結算 */
    .summary-box { background: var(--color-bg); border-radius: var(--radius-lg); padding: 18px 20px; margin-bottom: 24px; border: 1px solid var(--color-border); }
    .summary-line { display: flex; justify-content: space-between; font-size: 15px; margin-bottom: 6px; }
    .summary-total { font-size: 18px; font-weight: 900; color: var(--color-primary); border-top: 1px solid var(--color-border); padding-top: 10px; margin-top: 10px; }

    /* Modal 深色背景 + 獨立純白圖框 */
    .modal-dark-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(2, 6, 23, 0.75);
      backdrop-filter: blur(4px);
      z-index: 999;
      justify-content: center;
      align-items: center;
      padding: 16px;
    }
    .modal-dark-container {
      background: #111827;
      color: #E2E8F0;
      width: 100%;
      max-width: 580px;
      max-height: 85vh;
      border-radius: var(--radius-xl);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      border: 1px solid #374151;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
    }
    .modal-sticky-header {
      position: sticky;
      top: 0;
      background: #111827;
      padding: 16px 20px;
      border-bottom: 1px solid #374151;
      display: flex;
      justify-content: space-between;
      align-items: center;
      z-index: 20;
    }
    .modal-header-title { font-size: 18px; font-weight: 800; color: #FFFFFF; }
    .modal-btn-close {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: #1F2937;
      color: #9CA3AF;
      border: none;
      font-size: 18px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s ease;
    }
    .modal-btn-close:hover { background: #374151; color: #FFF; }
    .modal-scroll-body {
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      overscroll-behavior: contain;
      padding: 20px;
      font-size: 15px;
      line-height: 1.7;
      color: #CBD5E1;
    }
    .modal-white-image-box {
      width: 240px;
      height: 240px;
      margin: 0 auto 18px auto;
      border-radius: 16px;
      background: #FFFFFF;
      padding: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 15px rgba(0,0,0,0.3);
    }
    .modal-white-image-box img { width: 100%; height: 100%; object-fit: contain; }
    .gallery-thumbs { display: flex; justify-content: center; gap: 10px; margin-top: 10px; }
    .gallery-thumb-btn {
      width: 50px;
      height: 50px;
      border-radius: 8px;
      background: #FFFFFF;
      padding: 4px;
      border: 1.5px solid #4B5563;
      cursor: pointer;
    }
    .gallery-thumb-btn img { width: 100%; height: 100%; object-fit: contain; }
    .modal-bottom-bar { border-top: 1px solid #374151; padding: 14px 20px; background: #1F2937; text-align: center; }
    .modal-btn-full-close {
      width: 100%;
      background: #374151;
      color: #FFFFFF;
      font-size: 15px;
      font-weight: 700;
      padding: 10px 0;
      border-radius: var(--radius-md);
      border: none;
      cursor: pointer;
      transition: background 0.2s ease;
    }
    .modal-btn-full-close:hover { background: #4B5563; }

    /* Block K 逐級向上平滑導航狀態機 */
    .elevator-btn {
      position: fixed;
      bottom: 24px;
      right: 24px;
      width: 48px;
      height: 48px;
      background: var(--color-primary);
      color: #FFF;
      border-radius: 50%;
      border: none;
      font-size: 20px;
      font-weight: 900;
      cursor: pointer;
      box-shadow: var(--shadow-lg);
      z-index: 90;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform 0.2s ease;
    }
    .elevator-btn:hover { transform: scale(1.08); background: var(--color-primary-dark); }
  
    /* Block M: 常見 Q&A 手風琴專區 */
    .qa-accordion {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .qa-item {
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      overflow: hidden;
      transition: all 0.25s ease;
    }
    .qa-item[open] {
      background: var(--color-surface);
      border-color: var(--color-accent);
      box-shadow: 0 4px 14px rgba(13, 148, 136, 0.08);
    }
    .qa-summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 18px 20px;
      font-size: 16px;
      font-weight: 700;
      color: var(--color-primary);
      cursor: pointer;
      list-style: none;
      user-select: none;
      line-height: 1.5;
    }
    .qa-summary::-webkit-details-marker {
      display: none;
    }
    .qa-q-wrap {
      display: flex;
      align-items: baseline;
      gap: 10px;
      flex: 1;
      padding-right: 12px;
    }
    .qa-q-tag {
      color: var(--color-accent);
      font-weight: 800;
      font-size: 15px;
      flex-shrink: 0;
    }
    .qa-toggle-icon {
      width: 20px;
      height: 20px;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--color-text-sub);
      transition: transform 0.25s ease, color 0.25s ease;
    }
    .qa-toggle-icon svg {
      width: 16px;
      height: 16px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2.2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    .qa-item[open] .qa-toggle-icon {
      transform: rotate(180deg);
      color: var(--color-accent);
    }
    .qa-answer {
      padding: 0 20px 20px 20px;
      font-size: 15px !important;
      line-height: 1.75;
      color: var(--color-text-main);
      border-top: 1px solid var(--color-border);
      margin-top: 4px;
      padding-top: 16px;
    }
    .qa-answer p,
    .qa-answer ul,
    .qa-answer li,
    .qa-answer span,
    .qa-answer div {
      font-size: 15px !important;
      line-height: 1.75;
      color: var(--color-text-main);
    }
    .qa-strategy-box {
      background: #F8FAFC;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      padding: 14px 18px;
      margin: 12px 0;
      font-size: 15px;
      line-height: 1.75;
      color: var(--color-text-main);
    }
    .qa-strategy-box strong {
      display: block;
      margin-bottom: 4px;
      color: var(--color-primary);
      font-size: 15px;
      font-weight: 700;
    }
    .qa-strategy-box p {
      margin: 0;
      color: var(--color-text-main);
      font-size: 15px;
      line-height: 1.75;
    }

  
  </style>
</head>
<body>

  <!-- Nav Bar: 封閉式零外跳導航 (保留顯微鏡 Emoji 🔬 Health Decoder) -->
  <nav class="navbar">
    <div class="nav-container">
      <div class="nav-brand">
        🔬 Health Decoder <span>健康解碼</span>
      </div>
    </div>
  </nav>

  <div class="container">

    <!-- Block A: 頂部 Hero 區 ✕ 極速自測引導 (與夜尿專頁完全一致的精準乾淨結構) -->
        <!-- Block A: 頂部 Hero 區 ✕ 極速自測引導 -->
    <section id="blockA" class="section-card" style="text-align: center;">
      <h1 style="font-size: 30px; font-weight: 900; line-height: 1.35; color: var(--color-primary); margin-bottom: 8px;">
        手腳漸幼、企起無力，<br>年紀大自然縮水定係肌膜流失？
      </h1>
      <div style="font-size: 20px; font-weight: 800; color: var(--color-accent); margin-bottom: 20px;">
        搞清楚源頭，先可以治本。
      </div>
      
      <div style="max-width: 480px; margin: 0 auto 20px auto;">
        <button type="button" class="btn-primary" onclick="scrollToId('blockB')">
          馬上開始初步自我診斷
        </button>
      </div>

      <!-- 信任卡片 (獨立逐行排版，徹底解決手機端折行溢出) -->
      <div class="hero-trust-box">
        <div class="hero-trust-name">Duncan Chan</div>
        <div class="hero-trust-tag">工程師邏輯 ✕ 代謝底層解碼</div>
        <div class="hero-trust-desc">拒將退化當宿命，從源頭除錯，守住不求人的自理底氣。</div>
        <div class="hero-trust-url">health-decoder.com</div>
      </div>
    </section>

    <!-- Block B: 初步自我診斷問卷 -->
        <section id="blockB" class="section-card">
      <div style="margin-bottom: 24px; text-align: center;">
        <h2 style="justify-content: center; margin: 0; font-size: 24px;">📋 請完成以下問卷作初步自我診斷。</h2>
      </div>

      <form id="assessmentForm" onsubmit="event.preventDefault(); submitAssessment();">
        <!-- 個人資料輸入 -->
        <div class="user-info-grid">
          <div>
            <label style="font-size: 15px; font-weight: 700; display: block; margin-bottom: 6px; color: var(--color-text-main);">稱呼 *</label>
            <input type="text" id="quizUserName" class="input-field" placeholder="請輸入你的稱呼" required>
          </div>
          <div>
            <label style="font-size: 15px; font-weight: 700; display: block; margin-bottom: 6px; color: var(--color-text-main);">性別 *</label>
            <select id="quizGender" class="input-field">
              <option value="男">男</option>
              <option value="女">女</option>
            </select>
          </div>
          <div>
            <label style="font-size: 15px; font-weight: 700; display: block; margin-bottom: 6px; color: var(--color-text-main);">年齡區間 *</label>
            <select id="quizAge" class="input-field">
              <option value="45以下">45 歲以下</option>
              <option value="46–55">46–55 歲</option>
              <option value="56–65" selected>56–65 歲</option>
              <option value="65–75">65–75 歲</option>
              <option value="75以上">75 歲以上</option>
            </select>
          </div>
        </div>

        <!-- 模組零：臨床急症紅旗狀況篩查【單選・安全阻斷】 -->
        <div class="quiz-group" style="border-left: 4px solid var(--color-danger);">
          <div class="quiz-group-header">
            <div class="quiz-num" style="background: var(--color-danger-bg); color: var(--color-danger);">!</div>
            <div>
              <div class="quiz-title" style="color: #991B1B;">安全第一：嚴重風險警告提示（急症紅旗排查）【單選】</div>
            </div>
          </div>
          <div class="options-grid">
            <label class="option-label">
              <input type="radio" name="dim_redflag" value="RF_WEIGHT">
              <span><strong>體重非意願性驟降：</strong>在無刻意節食或減重情況下，最近 6 至 12 個月內體重下降超過 5%（需優先就醫排查急性消耗）。</span>
            </label>
            <label class="option-label">
              <input type="radio" name="dim_redflag" value="RF_CONSUME">
              <span><strong>面部與骨骼顯著消耗：</strong>雙側太陽穴顳肌明顯凹陷，鎖骨上窩與肋骨間隙深陷呈骨感樣態。</span>
            </label>
            <label class="option-label">
              <input type="radio" name="dim_redflag" value="RF_ORGAN">
              <span><strong>全身性器質症狀伴隨：</strong>無明確誘因持續低燒、夜間盜汗、進行性吞嚥困難、大便呈黑色瀝青狀或便血、腹部摸到硬塊。</span>
            </label>
            <label class="option-label">
              <input type="radio" name="dim_redflag" value="RF_HYPERMETAB">
              <span><strong>代謝異常亢進表徵：</strong>食慾亢進但體重持續急跌，伴隨靜止時心跳每分鐘超過 100 次與雙手震顫。</span>
            </label>
            <label class="option-label">
              <input type="radio" name="dim_redflag" value="RF_FAILURE">
              <span><strong>嚴重器官衰竭表徵：</strong>活動後嚴重氣促、夜間無法平躺呼吸、下肢嚴重凹陷性水腫。</span>
            </label>
            <label class="option-label none-opt">
              <input type="radio" name="dim_redflag" value="RF_NONE" checked>
              <span><strong>沒有上述情況：</strong>身體並無上述急性器質性消耗表徵。</span>
            </label>
          </div>
        </div>

        <!-- 第 1 組｜客觀功能篩查組件（AWGS 2019 標準）【可多選】 -->
        <div class="quiz-group">
          <div class="quiz-group-header">
            <div class="quiz-num">1</div>
            <div>
              <div class="quiz-title">第 1 組｜客觀動作與小腿圍度測量【可多選】</div>
            </div>
          </div>
          <div class="options-grid">
            <label class="option-label">
              <input type="checkbox" name="dim1" value="Q1_1" class="dim1-item" onclick="document.getElementById('dim1_none').checked = false;">
              <span>用雙手食指與拇指圍繞非主力腳小腿最粗位置，指環與小腿肚之間有明顯空隙。</span>
            </label>
            <label class="option-label">
              <input type="checkbox" name="dim1" value="Q1_2" class="dim1-item" onclick="document.getElementById('dim1_none').checked = false;">
              <span>雙手抱胸連續完成五次坐低企起身動作，總共耗時 12 秒以上。</span>
            </label>
            <label class="option-label">
              <input type="checkbox" name="dim1" value="Q1_3" class="dim1-item" onclick="document.getElementById('dim1_none').checked = false;">
              <span>擰開全新密封金屬罐頭蓋感到極度吃力甚至完全無法打開。</span>
            </label>
            <label class="option-label">
              <input type="checkbox" name="dim1" value="Q1_4" class="dim1-item" onclick="document.getElementById('dim1_none').checked = false;">
              <span>過去六個月內曾經有失足跌倒紀錄。</span>
            </label>
            <label class="option-label none-opt">
              <input type="checkbox" id="dim1_none" value="NONE" onchange="toggleDimNone('dim1')">
              <span>🚫 沒有上述情況</span>
            </label>
          </div>
        </div>

        <!-- 第 2 組｜同化代謝阻抗排查（成因一）【可多選・階梯賦分】 -->
        <div class="quiz-group">
          <div class="quiz-group-header">
            <div class="quiz-num">2</div>
            <div>
              <div class="quiz-title">第 2 組｜骨骼肌合成反應與同化阻抗排查【可多選】</div>
            </div>
          </div>
          <div class="options-grid">
            <label class="option-label">
              <input type="checkbox" name="dim2" value="Q2_1" class="dim2-item" onclick="document.getElementById('dim2_none').checked = false;">
              <span>平時每星期進行深蹲或阻力鍛鍊少過一次。</span>
            </label>
            <label class="option-label">
              <input type="checkbox" name="dim2" value="Q2_2" class="dim2-item" onclick="document.getElementById('dim2_none').checked = false;">
              <span>日常飲食極少攝取雞蛋、豆腐或肉類等優質蛋白質。</span>
            </label>
            <label class="option-label">
              <input type="checkbox" name="dim2" value="Q2_3" class="dim2-item" onclick="document.getElementById('dim2_none').checked = false;">
              <span>每日連續坐著或臥床時間長達 6 小時以上。</span>
            </label>
            <label class="option-label">
              <input type="checkbox" name="dim2" value="Q2_4" class="dim2-item" onclick="document.getElementById('dim2_none').checked = false;">
              <span>食量一直維持正常，四肢肌肉圍度依然隨年歲漸進縮細。</span>
            </label>
            <label class="option-label">
              <input type="checkbox" name="dim2" value="Q2_5" class="dim2-item" onclick="document.getElementById('dim2_none').checked = false;">
              <span>進行家務或步行較多之後，下肢肌肉痠痛持續三日以上難以復原。</span>
            </label>
            <label class="option-label">
              <input type="checkbox" name="dim2" value="Q2_6" class="dim2-item" onclick="document.getElementById('dim2_none').checked = false;">
              <span>過去一年食量與胃口維持平穩，四肢肌肉體積肉眼可見明顯變幼。</span>
            </label>
            <label class="option-label none-opt">
              <input type="checkbox" id="dim2_none" value="NONE" onchange="toggleDimNone('dim2')">
              <span>🚫 沒有上述情況</span>
            </label>
          </div>
        </div>

        <!-- 第 3 組｜萎縮性消化吸收障礙排查（成因二）【可多選・階梯賦分】 -->
        <div class="quiz-group">
          <div class="quiz-group-header">
            <div class="quiz-num">3</div>
            <div>
              <div class="quiz-title">第 3 組｜消化解離與胃腸吸收障礙排查【可多選】</div>
            </div>
          </div>
          <div class="options-grid">
            <label class="option-label">
              <input type="checkbox" name="dim3" value="Q3_1" class="dim3-item" onclick="document.getElementById('dim3_none').checked = false;">
              <span>平時食飯習慣急促，每餐 15 分鐘以內食完。</span>
            </label>
            <label class="option-label">
              <input type="checkbox" name="dim3" value="Q3_2" class="dim3-item" onclick="document.getElementById('dim3_none').checked = false;">
              <span>經常出現餐後胃脹上頂或喉嚨反酸。</span>
            </label>
            <label class="option-label">
              <input type="checkbox" name="dim3" value="Q3_3" class="dim3-item" onclick="document.getElementById('dim3_none').checked = false;">
              <span>進食固體肉類之後，上腹持續有飽滯沉重感。</span>
            </label>
            <label class="option-label">
              <input type="checkbox" name="dim3" value="Q3_4" class="dim3-item" onclick="document.getElementById('dim3_none').checked = false;">
              <span>進食正餐幾啖之後迅速出現明顯飽腹感。</span>
            </label>
            <label class="option-label">
              <input type="checkbox" name="dim3" value="Q3_5" class="dim3-item" onclick="document.getElementById('dim3_none').checked = false;">
              <span>日常大便經常見到未消化嘅蔬菜纖維或食物殘渣。</span>
            </label>
            <label class="option-label">
              <input type="checkbox" name="dim3" value="Q3_6" class="dim3-item" onclick="document.getElementById('dim3_none').checked = false;">
              <span>胃鏡檢查報告曾經證實有慢性萎縮性胃炎或胃黏膜變薄。</span>
            </label>
            <label class="option-label none-opt">
              <input type="checkbox" id="dim3_none" value="NONE" onchange="toggleDimNone('dim3')">
              <span>🚫 沒有上述情況</span>
            </label>
          </div>
        </div>

        <!-- 第 4 組｜全身慢性低度發炎異化排查（成因三）【可多選・階梯賦分】 -->
        <div class="quiz-group">
          <div class="quiz-group-header">
            <div class="quiz-num">4</div>
            <div>
              <div class="quiz-title">第 4 組｜慢性低度發炎與肌蛋白異化排查【可多選】</div>
            </div>
          </div>
          <div class="options-grid">
            <label class="option-label">
              <input type="checkbox" name="dim4" value="Q4_1" class="dim4-item" onclick="document.getElementById('dim4_none').checked = false;">
              <span>經常受牙齦腫痛出血或慢性牙周炎困擾。</span>
            </label>
            <label class="option-label">
              <input type="checkbox" name="dim4" value="Q4_2" class="dim4-item" onclick="document.getElementById('dim4_none').checked = false;">
              <span>腰腹脂肪明顯堆積，呈現中央腹型身形。</span>
            </label>
            <label class="option-label">
              <input type="checkbox" name="dim4" value="Q4_3" class="dim4-item" onclick="document.getElementById('dim4_none').checked = false;">
              <span>每日起床經常感到全身關節肌肉深層酸楚發僵。</span>
            </label>
            <label class="option-label">
              <input type="checkbox" name="dim4" value="Q4_4" class="dim4-item" onclick="document.getElementById('dim4_none').checked = false;">
              <span>日常身體持續有沉重疲累感，獲得充足睡眠依然難以消除。</span>
            </label>
            <label class="option-label">
              <input type="checkbox" name="dim4" value="Q4_5" class="dim4-item" onclick="document.getElementById('dim4_none').checked = false;">
              <span>長期伴隨微溫感或身體經常有微熱不適。</span>
            </label>
            <label class="option-label">
              <input type="checkbox" name="dim4" value="Q4_6" class="dim4-item" onclick="document.getElementById('dim4_none').checked = false;">
              <span>抽血檢驗報告顯示高敏丙反應蛋白 hs-CRP 數值持續高於正常標準。</span>
            </label>
            <label class="option-label none-opt">
              <input type="checkbox" id="dim4_none" value="NONE" onchange="toggleDimNone('dim4')">
              <span>🚫 沒有上述情況</span>
            </label>
          </div>
        </div>

        <!-- 第 5 組｜粒線體衰退與快肌纖維萎縮排查（成因四）【可多選・階梯賦分】 -->
        <div class="quiz-group">
          <div class="quiz-group-header">
            <div class="quiz-num">5</div>
            <div>
              <div class="quiz-title">第 5 組｜粒線體衰退與快肌纖維萎縮排查【可多選】</div>
            </div>
          </div>
          <div class="options-grid">
            <label class="option-label">
              <input type="checkbox" name="dim5" value="Q5_1" class="dim5-item" onclick="document.getElementById('dim5_none').checked = false;">
              <span>踩單車或者急步登梯時感到雙腿極容易痠軟無力。</span>
            </label>
            <label class="option-label">
              <input type="checkbox" name="dim5" value="Q5_2" class="dim5-item" onclick="document.getElementById('dim5_none').checked = false;">
              <span>日常生活完全缺乏快步行走或階梯上下運動。</span>
            </label>
            <label class="option-label">
              <input type="checkbox" name="dim5" value="Q5_3" class="dim5-item" onclick="document.getElementById('dim5_none').checked = false;">
              <span>日常平路慢步行走尚可支撐，過馬路想加快步伐時感到雙腳使唔出爆發力。</span>
            </label>
            <label class="option-label">
              <input type="checkbox" name="dim5" value="Q5_4" class="dim5-item" onclick="document.getElementById('dim5_none').checked = false;">
              <span>平時在凹凸不平路面行走容易被地面輕微凸起絆倒。</span>
            </label>
            <label class="option-label">
              <input type="checkbox" name="dim5" value="Q5_5" class="dim5-item" onclick="document.getElementById('dim5_none').checked = false;">
              <span>行路一旦失足絆倒，身體反應遲緩難以即時跨步穩住重心。</span>
            </label>
            <label class="option-label none-opt">
              <input type="checkbox" id="dim5_none" value="NONE" onchange="toggleDimNone('dim5')">
              <span>🚫 沒有上述情況</span>
            </label>
          </div>
        </div>

        <!-- 第 6 組｜神經支配重塑與肌力協調排查（成因五）【可多選・階梯賦分】 -->
        <div class="quiz-group">
          <div class="quiz-group-header">
            <div class="quiz-num">6</div>
            <div>
              <div class="quiz-title">第 6 組｜神經支配重塑與肌力協調排查【可多選】</div>
            </div>
          </div>
          <div class="options-grid">
            <label class="option-label">
              <input type="checkbox" name="dim6" value="Q6_1" class="dim6-item" onclick="document.getElementById('dim6_none').checked = false;">
              <span>雙腳腳趾或腳掌邊緣日常有對稱性輕微麻木感。</span>
            </label>
            <label class="option-label">
              <input type="checkbox" name="dim6" value="Q6_2" class="dim6-item" onclick="document.getElementById('dim6_none').checked = false;">
              <span>閉上雙眼站立時身體容易左右輕微搖晃不穩。</span>
            </label>
            <label class="option-label">
              <input type="checkbox" name="dim6" value="Q6_3" class="dim6-item" onclick="document.getElementById('dim6_none').checked = false;">
              <span>手指精細動作靈活度減弱，日常扣鈕扣或穿針線感到笨拙。</span>
            </label>
            <label class="option-label">
              <input type="checkbox" name="dim6" value="Q6_4" class="dim6-item" onclick="document.getElementById('dim6_none').checked = false;">
              <span>擰乾濕毛巾或手提日常餸菜袋時經常感到手軟滑脫。</span>
            </label>
            <label class="option-label">
              <input type="checkbox" name="dim6" value="Q6_5" class="dim6-item" onclick="document.getElementById('dim6_none').checked = false;">
              <span>從一般無扶手餐椅企起身，必須用雙手按壓膝頭或枱面借力。</span>
            </label>
            <label class="option-label none-opt">
              <input type="checkbox" id="dim6_none" value="NONE" onchange="toggleDimNone('dim6')">
              <span>🚫 沒有上述情況</span>
            </label>
          </div>
        </div>

        <!-- 第 7 組｜香港公立醫院常見用藥排查與審查【可多選】 -->
        <div class="quiz-group">
          <div class="quiz-group-header">
            <div class="quiz-num">7</div>
            <div>
              <div class="quiz-title">第 7 組｜香港公立醫院臨床常規西藥審查【可多選】</div>
            </div>
          </div>
          <div class="options-grid">
            <label class="option-label">
              <input type="checkbox" name="dim7" value="Q7_1" class="dim7-item" onclick="document.getElementById('dim7_none').checked = false;">
              <span>長期每日服用質子泵抑制劑 PPI 胃藥（例如奧美拉唑 Omeprazole、泮托拉唑 Pantoprazole）。</span>
            </label>
            <label class="option-label">
              <input type="checkbox" name="dim7" value="Q7_2" class="dim7-item" onclick="document.getElementById('dim7_none').checked = false;">
              <span>長期服用他汀類降膽固醇西藥 Statins（例如阿托伐他汀 Atorvastatin、瑞舒伐他汀 Rosuvastatin）。</span>
            </label>
            <label class="option-label">
              <input type="checkbox" name="dim7" value="Q7_3" class="dim7-item" onclick="document.getElementById('dim7_none').checked = false;">
              <span>長期服用雙胍類降血糖西藥 Metformin（格華止 Glucophage）。</span>
            </label>
            <label class="option-label">
              <input type="checkbox" name="dim7" value="Q7_4" class="dim7-item" onclick="document.getElementById('dim7_none').checked = false;">
              <span>長期服用口服類固醇藥物（例如潑尼松龍 Prednisolone）。</span>
            </label>
            <label class="option-label">
              <input type="checkbox" name="dim7" value="Q7_5" class="dim7-item" onclick="document.getElementById('dim7_none').checked = false;">
              <span>長期服用降血壓利尿劑水丸（例如吲達帕胺 Indapamide、速尿 Furosemide）。</span>
            </label>
            <label class="option-label">
              <input type="checkbox" id="med_warfarin" name="dim7" value="MED_WARFARIN" class="dim7-item" onclick="document.getElementById('dim7_none').checked = false;">
              <span>長期服用抗凝血薄血藥物（華法林 Warfarin 或新型口服抗凝藥 NOAC / DOAC）。</span>
            </label>
            <label class="option-label none-opt">
              <input type="checkbox" id="dim7_none" value="NONE" onchange="toggleDimNone('dim7')">
              <span>🚫 沒有長期服用上述西藥</span>
            </label>
          </div>
        </div>

        <div style="margin-top: 28px;">
          <button type="button" class="btn-accent" style="font-size: 19px; padding: 16px 24px; font-weight: 800; width: 100%;" onclick="submitAssessment()">
            請按此提交，以了解真正成因
          </button>
        </div>
      </form>
    </section>

<div id="gated-content" style="display: none;">

      <!-- Block C: 診斷結果判定 ✕ 最壞情況直擊 (100% 還原 Version 5 高質感架構) -->
      <section id="blockC" class="section-card">
        
        <!-- 1. 深色成因判定卡片 -->
        <div class="diagnosis-highlight-card">
          <div style="font-size: 15px; font-weight: 700; color: #5EEAD4; margin-bottom: 6px;">
            🏷️ 系統判定主要成因為：
          </div>
          <h2 id="diagPrimaryTitle" style="color: #FFFFFF; font-size: 26px; margin: 10px 0; font-weight: 900;">
            【成因 01：力學與姿勢型】
          </h2>
          <p id="diagPrimaryDesc" style="color: #CBD5E1; font-size: 16.5px; line-height: 1.65; margin: 0;"></p>
        </div>

        <!-- 2. 五大成因佔比進度條 -->
        <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 22px; margin-bottom: 24px; box-shadow: var(--shadow-sm);">
          <h4 style="margin: 0 0 16px 0; font-size: 16px; font-weight: 800; color: var(--color-primary);">
            📊 混合式成因佔比綜合演算結果
          </h4>
          <div id="causeRatioList"></div>
        </div>

        <!-- 3. 痛點直擊最壞情況 (大字級粗體 18px · 純文字 · 零引號 · 零標籤) -->
        <div class="fear-quote-box">
          <div id="fearQuoteText" style="font-size: 18px; font-weight: 700; line-height: 1.65;"></div>
        </div>

        <!-- 4. 薄血藥避險警告 (動態顯示 · 合規醫囑標準版) -->
        <div id="thinBloodAlert" class="warning-gold-box" style="display: none;">
          <div style="font-weight: 800; font-size: 17px; margin-bottom: 6px;">⚠️ 臨床用藥避險警告：偵測到您正在服用薄血藥</div>
          <p style="margin: 0; font-size: 15px; color: #78350F; line-height: 1.65;">
            您的凝血功能正受藥物調控，在決定自行使用任何與藥物有潛在衝突的食物/保健品之前，請先諮詢你的主診醫生。
          </p>
        </div>

        <!-- 5. 完整專業免責聲明 (100% 完整法律宣告 · 零刪減) -->
        <div style="background: var(--color-primary-light); border-radius: var(--radius-md); padding: 16px 20px; font-size: 14px; color: var(--color-text-sub); margin-bottom: 24px; line-height: 1.65;">
          ⚠️ <strong>專業免責聲明：</strong>本自測僅供個人自我健康評估參考，內容基於用戶主觀填寫之體感數據進行邏輯推演。本系統不作任何形式的正式醫療診斷、醫療建議或處方指引。如有醫療需求，請諮詢執業醫師。
        </div>

        <!-- 6. 行動按鍵 (純文字 · 零符號) -->
        <button type="button" class="btn-primary" onclick="scrollToId('blockD')">
          想知點解會出現呢個成因
        </button>
      </section>

      <!-- Block D: 成因生理解碼 ✕ Vimeo 短影音 -->
      <section id="blockD" class="section-card">
        <h2 id="block-d-title" style="margin-top: 0;">成因解碼</h2>
        
        <div class="video-container" style="position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: var(--radius-md); margin-bottom: 20px; background: #000;">
          <iframe id="vimeo-block-d" src="" style="position: absolute; top:0; left: 0; width: 100%; height: 100%; border:0;" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
        </div>

        <!-- 單一緊湊灰色背景框 -->
        <div style="background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 20px; margin-bottom: 20px;">
          <div style="margin-bottom: 14px;">
            <div style="font-weight: 800; font-size: 16px; color: var(--color-primary); margin-bottom: 4px;">🔬 生理機轉與病理路徑</div>
            <p id="block-d-bio" style="margin: 0; font-size: 15.5px; color: var(--color-text-muted); line-height: 1.7;"></p>
          </div>
          <div style="border-top: 1px solid var(--color-border); padding-top: 14px;">
            <div style="font-weight: 800; font-size: 16px; color: var(--color-accent-text); margin-bottom: 4px;">⚙️ 系統工程比喻</div>
            <p id="block-d-eng" style="margin: 0; font-size: 15.5px; color: var(--color-text-muted); line-height: 1.7;"></p>
          </div>
        </div>

        <button type="button" class="btn-primary" onclick="scrollToId('blockE')">
          想知生活上有咩簡單改善小貼士
        </button>
      </section>

      <!-- Block E: 生活微習慣 ✕ Vimeo 短影音 -->
      <section id="blockE" class="section-card">
        <h2 style="margin-top: 0;">生活上嘅改善小貼士</h2>
        
        <div class="video-container" style="position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: var(--radius-md); margin-bottom: 20px; background: #000;">
          <iframe id="vimeo-block-e" src="" style="position: absolute; top:0; left: 0; width: 100%; height: 100%; border:0;" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
        </div>

        <!-- 單一緊湊微習慣框 -->
        <div id="block-e-steps" style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 20px; margin-bottom: 20px; box-shadow: var(--shadow-sm);"></div>

        <!-- 大字級局限警告 (17px 粗體 · 純文字) -->
        <div id="block-e-warn" style="background: #FFFBEB; border-left: 4px solid #F59E0B; border-radius: 0 var(--radius-md) var(--radius-md) 0; padding: 16px 20px; color: #92400E; font-size: 17px; font-weight: 700; line-height: 1.65; margin-bottom: 20px;"></div>

        <button type="button" class="btn-primary" onclick="scrollToId('blockF')">
          想知有咩重點營養和保健方法，可從源頭去改善
        </button>
      </section>

      <!-- Block F: 營養與物理理療 ✕ Vimeo 短影音 -->
      <section id="blockF" class="section-card">
        <h2 style="margin-top: 0;">重點營養和保健</h2>
        
        <div class="video-container" style="position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: var(--radius-md); margin-bottom: 20px; background: #000;">
          <iframe id="vimeo-block-f" src="" style="position: absolute; top:0; left: 0; width: 100%; height: 100%; border:0;" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
        </div>

        <!-- 單一緊湊生化機轉框 (100% 零商品名) -->
        <div id="block-f-nutrition" style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 20px; margin-bottom: 20px; font-size: 15.5px; color: var(--color-text-main); line-height: 1.75; box-shadow: var(--shadow-sm);"></div>

        <!-- 恢復情感共鳴金句橫幅 (17px–18px 粗體 · 純文字 · 零引號) -->
        <div id="block-f-emotion" style="background: var(--color-accent-light); border-radius: var(--radius-md); padding: 16px 20px; text-align: center; font-weight: 800; font-size: 17px; color: var(--color-accent-text); margin-bottom: 20px; line-height: 1.6;"></div>

        <button type="button" class="btn-primary" onclick="scrollToId('blockG')">
          想知有咩營養同保健方案
        </button>
      </section>

      <!-- Block G: 精選專屬保健方案 (單鍵卡片，純淨無多餘標籤產地) -->
      <section id="blockG" class="section-card">
        <h2 style="margin-top: 0; margin-bottom: 20px;">精選專屬保健方案</h2>

        <div id="block-g-products-list"></div>

        <div style="margin-top: 24px;">
          <button type="button" class="btn-accent" style="width: 100%; font-size: 18px; font-weight: 800; padding: 16px 28px; text-align: center;" onclick="scrollToId('blockH')">
            馬上行動！選取適合自己的改善方案
          </button>
        </div>
      </section>

      <!-- Block H: 選取改善方案 (緊湊雙行套裝，無頂部干擾橫幅，無行內產品列表，純淨物流表單) -->
      <section id="blockH" class="section-card">
        <h2 style="margin-top: 0;">選取適合自己的改善方案</h2>

        <!-- 第一層：單品選購列表 -->
        <div style="margin-bottom: 24px;">
          <div id="block-h-single-products"></div>
        </div>

        <!-- 第二層：30 天主力套裝列表 -->
        <div style="margin-bottom: 24px;">
          <div id="block-h-bundles"></div>
        </div>

        <!-- 第三層：購物車與動態運費計算 -->
        <div class="summary-box">
          <div style="font-weight: 800; font-size: 16px; color: var(--color-primary); margin-bottom: 10px;">已選項目結算</div>
          <div id="cart-summary-items" style="color: var(--color-text-muted); font-size: 14.5px; margin-bottom: 10px;">
            購物車目前為空
          </div>
          <div style="border-top: 1px solid var(--color-border); padding-top: 10px;">
            <div class="summary-line">
              <span>商品小計</span>
              <span id="cart-subtotal">HKD 0</span>
            </div>
            <div class="summary-line">
              <span>運費（滿 HKD 400 免費）</span>
              <span id="cart-shipping">HKD 0</span>
            </div>
            <div class="summary-line summary-total">
              <span>應付總額</span>
              <span id="cart-total">HKD 0</span>
            </div>
          </div>
        </div>

        <!-- 第四層：物流訊息表單 (單欄獨立分行，付款方式選項，純淨地址 Placeholder) -->
        <form id="orderForm" style="background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 20px;">
          <h3 style="font-size: 16px; font-weight: 800; color: var(--color-primary); margin-bottom: 14px;">📦 填寫物流訊息</h3>
          <div style="margin-bottom: 12px;">
            <label style="font-size: 14px; font-weight: 700; display: block; margin-bottom: 4px;">收件人姓名 *</label>
            <input type="text" id="order_recipient_name" class="input-field" placeholder="請填寫收件人姓名" required>
          </div>
          <div style="margin-bottom: 12px;">
            <label style="font-size: 14px; font-weight: 700; display: block; margin-bottom: 4px;">聯絡電話 *</label>
            <input type="tel" id="order_recipient_phone" class="input-field" placeholder="請填寫香港聯絡電話" required>
          </div>
          <div style="margin-bottom: 12px;">
            <label style="font-size: 14px; font-weight: 700; display: block; margin-bottom: 4px;">收貨詳細地址 *</label>
            <textarea id="order_recipient_address" class="input-field" rows="2" placeholder="請填詳細收貨地址" required></textarea>
          </div>
          <div style="margin-bottom: 18px;">
            <label class="quiz-option" style="margin: 0; align-items: center; display: flex;">
              <input type="checkbox" id="order_has_lift" checked style="width: 18px; height: 18px; margin-right: 8px;">
