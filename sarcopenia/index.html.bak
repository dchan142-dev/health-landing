  <!-- 前端完整核心數據庫與邏輯引擎 -->
  <script>
    const APPS_SCRIPT_WEBHOOK_URL = "https://script.google.com/macros/s/AKfycbwCuvvuaVpJoDvHvts9y1AMrJ_TGomqG6HY7k1nJohKh8ca7WmsuYITBFWQ/exec"; 
    const DUNCAN_WHATSAPP_PHONE = "85298788564";

    let savedScrollY = 0;
    let selectedCauseId = 1;
    let isWarfarinUser = false;
    let cart = {};

    const TOPIC_CONFIG = {
  "topicId": "sarcopenia",
  "topicName": "肌少症與消瘦專題",
  "topicShortName": "肌少症",
  "metaTitle": "Health Decoder｜肌少症與消瘦專題 · 從源頭除錯",
  "hero": {
    "h1": "手腳漸幼、企起無力，<br>年紀大自然縮水定係肌膜流失？",
    "subtitle": "搞清楚源頭，先可以治本。",
