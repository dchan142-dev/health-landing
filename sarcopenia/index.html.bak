    const CAUSES_DATA = TOPIC_CONFIG.causesData;

    function toggleDimNone(dim) {
      const noneBox = document.getElementById(dim + '_none');
      const items = document.querySelectorAll('.' + dim + '-item');
      if (noneBox.checked) {
        items.forEach(el => { el.checked = false; });
      }
    }

    function scrollToId(id) {
      const el = document.getElementById(id);
      if (el) {
        el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    // =========================================================================
    // 問卷提交與成因仲裁邏輯 (含無徵狀警號攔截，徹底防止錯誤 Default 至成因一)
    // =========================================================================
    function submitAssessment() {
      const userName = document.getElementById('quizUserName').value.trim();
      if (!userName) {
        alert('請輸入你的稱呼');
        document.getElementById('quizUserName').focus();
        return;
      }

      // 紅旗檢查 (若頁面有配置紅旗題組)
      const rfChecked = document.querySelector('input[name="dim_redflag"]:checked');
      if (rfChecked && rfChecked.value !== 'RF_NONE') {
        alert('⚠️ 系統安全提示：偵測到您勾選了急性或危急紅旗徵候（如疑似深靜脈血栓或動脈急症）。為保障您的健康安全，請勿大力按揉，並請立即尋求急診或專科醫師進行正規醫療檢查！');
      }

      // 檢查是否全選「沒有上述情況」或完全未填具體徵狀
      const quizForm = document.getElementById('assessmentForm') || document.getElementById('blockB');
      const hasPositiveCheck = quizForm ? quizForm.querySelectorAll('input[type="checkbox"]:checked:not([value="NONE"]):not([id$="_none"])').length > 0 : false;
      const hasPositiveRadio = quizForm ? quizForm.querySelectorAll('input[type="radio"]:checked:not([value="NONE"]):not([value="RF_NONE"]):not([id$="_none"])').length > 0 : false;

      if (!hasPositiveCheck && !hasPositiveRadio) {
        alert(`提示：您填選的項目中並無任何${TOPIC_CONFIG.topicShortName || '相關'}徵狀（或可能填選有誤）。若您確實有相關症狀，請重新核對並填選符合您身體狀況的選項。`);
        document.getElementById('blockB').scrollIntoView({ behavior: 'smooth', block: 'start' });
        return;
      }

      // 薄血藥審查
      isWarfarinUser = document.getElementById('med_warfarin') ? document.getElementById('med_warfarin').checked : false;

      const causeIds = Object.keys(CAUSES_DATA).map(k => parseInt(k)).sort((a, b) => a - b);
      let scores = {};
      let hasHardcore = {};
      causeIds.forEach(id => {
        scores[id] = 0;
        hasHardcore[id] = false;
      });

      if (TOPIC_CONFIG.scoringRules) {
        for (const [dimName, optionMap] of Object.entries(TOPIC_CONFIG.scoringRules)) {
          document.querySelectorAll(`input[name="${dimName}"]:checked`).forEach(el => {
            const rule = optionMap[el.value];
            if (rule) {
              if (Array.isArray(rule)) {
                // 陣列格式 [cause, pts, isHc]
                const c = rule[0];
                scores[c] = (scores[c] || 0) + rule[1];
                if (rule.length > 2 && rule[2]) hasHardcore[c] = true;
              } else if (typeof rule === 'object') {
                // 字典格式 {"1": 5, "hardcore": 1} 或 {"4": 4, "3": 3}
                for (const [k, v] of Object.entries(rule)) {
                  if (k === 'hardcore') {
                    hasHardcore[v] = true;
                  } else {
                    const c = parseInt(k);
                    if (!isNaN(c)) scores[c] = (scores[c] || 0) + v;
                  }
                }
              }
            }
          });
        }
      }

      if (TOPIC_CONFIG.maxScoreRule && scores[TOPIC_CONFIG.maxScoreRule.cause] > TOPIC_CONFIG.maxScoreRule.max) {
        scores[TOPIC_CONFIG.maxScoreRule.cause] = TOPIC_CONFIG.maxScoreRule.max;
      } else if (scores[5] !== undefined && scores[5] > 7) {
        scores[5] = 7;
      }

      // 年齡加權 (65 歲以上乘 1.2)
      const ageSelect = document.getElementById('quizAge').value;
      if (ageSelect.includes('65') || ageSelect.includes('75')) {
        causeIds.forEach(i => {
          scores[i] = Math.round((scores[i] || 0) * 1.2 * 10) / 10;
        });
      }

      // 仲裁最高分
      const maxScore = Math.max(...causeIds.map(i => scores[i] || 0));
      if (maxScore <= 0) {
        alert(`提示：您填選的項目中並無任何${TOPIC_CONFIG.topicShortName || '相關'}徵狀（或可能填選有誤）。請重新核對並填選符合您身體狀況的選項。`);
        document.getElementById('blockB').scrollIntoView({ behavior: 'smooth', block: 'start' });
        return;
      }

      let candidates = [];
      causeIds.forEach(i => {
        if (scores[i] === maxScore) candidates.push(i);
      });

      let chosenCause = candidates[0];
      if (candidates.length > 1) {
        let hardcoreCandidates = candidates.filter(c => hasHardcore[c]);
        if (hardcoreCandidates.length === 1) {
          chosenCause = hardcoreCandidates[0];
        } else {
          const priority = TOPIC_CONFIG.arbitrationPriority || [1, 2, 3, 4, 5];
          const pool = hardcoreCandidates.length > 1 ? hardcoreCandidates : candidates;
          for (let p of priority) {
            if (pool.includes(p)) {
              chosenCause = p;
              break;
            }
          }
        }
      }

      selectedCauseId = chosenCause;

      // 解鎖受限內容
      document.getElementById('gated-content').style.display = 'block';

      // 渲染各區塊
      renderGatedContent(selectedCauseId, scores);

      // 平滑滾動至 Block C (確保 DOM 佈局完成)
      setTimeout(() => {
        setTimeout(() => { scrollToId('blockC'); }, 80);
      }, 60);
    }

    function renderGatedContent(causeId, scores) {
      const cData = CAUSES_DATA[causeId];
      if (!cData) return;

      // 1. Block C
      document.getElementById('diagPrimaryTitle').innerText = `【${cData.name}】`;
      document.getElementById('diagPrimaryDesc').innerText = cData.bio;
      document.getElementById('fearQuoteText').innerText = cData.worstCase;

      // 佔比進度條 (動態支援任意成因數量，如 4 成因或 5 成因)
      const causeIds = Object.keys(CAUSES_DATA).map(k => parseInt(k)).sort((a, b) => a - b);
      let totalScore = causeIds.reduce((sum, id) => sum + (scores[id] || 0), 0);
      if (totalScore === 0) totalScore = 1;
      let ratioHtml = '';
      const barColors = { 1: 'c1-bar', 2: 'c2-bar', 3: 'c3-bar', 4: 'c4-bar', 5: 'c5-bar', 6: 'c1-bar', 7: 'c2-bar' };
      for (let i of causeIds) {
        if (!CAUSES_DATA[i]) continue;
        let pct = Math.round(((scores[i] || 0) / totalScore) * 100);
        let causeName = CAUSES_DATA[i].name;
        ratioHtml += `
          <div class="ratio-bar-wrap">
            <div class="ratio-info">
              <span>${causeName}</span>
              <span>${pct}%</span>
            </div>
            <div class="ratio-bar-bg">
              <div class="ratio-bar-fill ${barColors[i] || 'c1-bar'}" style="width: ${pct}%;"></div>
            </div>
          </div>
        `;
      }
      document.getElementById('causeRatioList').innerHTML = ratioHtml;

      // 薄血藥避險卡片
      document.getElementById('thinBloodAlert').style.display = isWarfarinUser ? 'block' : 'none';

      // 2. Block D
      document.getElementById('block-d-title').innerText = `成因解碼：${cData.name.replace(/^成因\s*\d+：/, '')}`;
      const vBoxD = document.getElementById('vimeo-block-d')?.closest('.video-container') || document.getElementById('vimeo-block-d')?.parentElement;
      if (cData.vimeoD && cData.vimeoD.trim() !== "") {
        let vUrlD = cData.vimeoD.startsWith('http') ? cData.vimeoD : `https://player.vimeo.com/video/${cData.vimeoD}?title=0&byline=0&portrait=0`;
        document.getElementById('vimeo-block-d').src = vUrlD;
        if (vBoxD) vBoxD.style.display = 'block';
      } else {
        if (vBoxD) vBoxD.style.display = 'none';
      }
      document.getElementById('block-d-bio').innerText = cData.bio;
      document.getElementById('block-d-eng').innerText = cData.eng;

      // 3. Block E
      const vBoxE = document.getElementById('vimeo-block-e')?.closest('.video-container') || document.getElementById('vimeo-block-e')?.parentElement;
      if (cData.vimeoE && cData.vimeoE.trim() !== "") {
        let vUrlE = cData.vimeoE.startsWith('http') ? cData.vimeoE : `https://player.vimeo.com/video/${cData.vimeoE}?title=0&byline=0&portrait=0`;
        document.getElementById('vimeo-block-e').src = vUrlE;
        if (vBoxE) vBoxE.style.display = 'block';
      } else {
        if (vBoxE) vBoxE.style.display = 'none';
      }
      let stepsHtml = '';
      cData.steps.forEach(s => {
        stepsHtml += `
          <div style="margin-bottom: 14px;">
            <div style="font-weight: 800; font-size: 16px; color: var(--color-primary); margin-bottom: 4px;">${s.title}</div>
            <p style="margin: 0; font-size: 15px; color: var(--color-text-muted); line-height: 1.65;">${s.desc}</p>
          </div>
        `;
      });
      document.getElementById('block-e-steps').innerHTML = stepsHtml;
      document.getElementById('block-e-warn').innerText = cData.warn;

      // 4. Block F
      const vBoxF = document.getElementById('vimeo-block-f')?.closest('.video-container') || document.getElementById('vimeo-block-f')?.parentElement;
      if (cData.vimeoF && cData.vimeoF.trim() !== "") {
        let vUrlF = cData.vimeoF.startsWith('http') ? cData.vimeoF : `https://player.vimeo.com/video/${cData.vimeoF}?title=0&byline=0&portrait=0`;
        document.getElementById('vimeo-block-f').src = vUrlF;
        if (vBoxF) vBoxF.style.display = 'block';
      } else {
        if (vBoxF) vBoxF.style.display = 'none';
      }
      let nutHtml = '';
      cData.nutrition.forEach(n => {
        nutHtml += `<p style="margin-bottom: 12px; line-height: 1.7;">${n}</p>`;
      });
      document.getElementById('block-f-nutrition').innerHTML = nutHtml;
      document.getElementById('block-f-emotion').innerText = cData.emotionQuote || cData.quoteF || '';

      // 5. 決定推薦單品與套裝 (含薄血藥避險替換)
      let allowedProducts = [...(cData.allowedProducts || [])];
      let allowedBundles = [...(cData.allowedBundles || [])];

      if (isWarfarinUser) {
        if (cData.allowedProductsWarfarin && cData.allowedProductsWarfarin.length > 0) {
          allowedProducts = [...cData.allowedProductsWarfarin];
        } else {
          allowedProducts = allowedProducts.filter(id => id !== '36282' && id !== '34274');
        }
        if (cData.allowedBundlesWarfarin && cData.allowedBundlesWarfarin.length > 0) {
          allowedBundles = [...cData.allowedBundlesWarfarin];
        }
      }

      // 渲染 Block G, Block H, Block J
      renderBlockG(allowedProducts, causeId);
      renderBlockH(allowedProducts, allowedBundles);
      renderBlockJ(cData.testimonials);
    }

    // =========================================================================
    // Block G: 精選專屬保健方案 (純淨單鍵卡片，無規格產地字眼干擾)
    // =========================================================================
    function renderBlockG(allowedProductIds, causeId) {
      const container = document.getElementById('block-g-products-list');
      container.innerHTML = '';
      PRODUCTS_DB.forEach(prod => {
        if (!allowedProductIds.includes(prod.id)) return;
        const card = document.createElement('div');
        card.className = 'product-single-card';
        const benefitText = prod.shortDesc || prod.intro || "從源頭深度調理代謝平衡";
        card.innerHTML = `
          <div class="p-card-top">
            <div class="p-card-name">${prod.name}</div>
            <button type="button" onclick="openMechanismModal('${prod.id}', ${causeId})" class="btn-more-b">
              想知更多
            </button>
          </div>
          <div class="p-card-desc">${benefitText}</div>
        `;
        container.appendChild(card);
      });
    }

    // =========================================================================
    // Block H: 選取方案 (緊湊雙行套裝，無頂部促銷橫幅，無內嵌清單，查看套裝明細按鈕)
    // =========================================================================
    function renderBlockH(allowedProductIds, allowedBundleIds) {
      // 1. 單品選購列表
      const singleContainer = document.getElementById('block-h-single-products');
      singleContainer.innerHTML = '';
      PRODUCTS_DB.forEach(prod => {
        if (!allowedProductIds.includes(prod.id)) return;
        const row = document.createElement('div');
        row.className = 'h-single-item-row';
        row.innerHTML = `
          <div class="h-item-info">
            <span class="h-item-title">${prod.name}</span>
            <span class="h-item-price">HKD ${prod.price.toLocaleString()}</span>
          </div>
          <button type="button" onclick="openProductModal('${prod.id}')" class="btn-detail-h">
            產品詳情
          </button>
          <div class="qty-control">
            <button type="button" class="qty-btn" onclick="updateCart('prod_${prod.id}', -1, ${prod.price}, '${prod.name}')">-</button>
            <span id="qty_prod_${prod.id}" class="qty-val">0</span>
            <button type="button" class="qty-btn" onclick="updateCart('prod_${prod.id}', 1, ${prod.price}, '${prod.name}')">+</button>
          </div>
        `;
        singleContainer.appendChild(row);
      });

      // 2. 套裝選購列表 (雙行緊湊，高調特惠價與折數)
      const bundleContainer = document.getElementById('block-h-bundles');
      bundleContainer.innerHTML = '';
      BUNDLES_DB.forEach(b => {
        if (!allowedBundleIds.includes(b.id)) return;
        const bCard = document.createElement('div');
        bCard.className = 'h-bundle-card';
        bCard.innerHTML = `
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
            <div style="font-weight: 900; font-size: 17px; color: var(--color-primary);">${b.name}</div>
            <button type="button" onclick="openBundleModal('${b.id}')" style="background: none; border: none; font-size: 13px; font-weight: 700; color: var(--color-accent); cursor: pointer; text-decoration: underline;">
              查看套裝明細
            </button>
          </div>
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; align-items: baseline; gap: 8px;">
              <span style="font-size: 20px; font-weight: 900; color: var(--color-accent-text);">HKD ${b.price.toLocaleString()}</span>
              <span style="font-size: 13px; color: #94A3B8; text-decoration: line-through;">HKD ${b.origPrice.toLocaleString()}</span>
              <span style="background: #FEE2E2; color: #B91C1C; padding: 2px 6px; border-radius: 4px; font-size: 12px; font-weight: 800;">${b.discount}（慳 HKD ${b.save.toLocaleString()}）</span>
            </div>
            <div class="qty-control">
              <button type="button" class="qty-btn" onclick="updateCart('bun_${b.id}', -1, ${b.price}, '${b.name}')">-</button>
              <span id="qty_bun_${b.id}" class="qty-val">0</span>
              <button type="button" class="qty-btn" onclick="updateCart('bun_${b.id}', 1, ${b.price}, '${b.name}')">+</button>
            </div>
          </div>
        `;
        bundleContainer.appendChild(bCard);
      });

      cart = {};
      recalculateCart();
    }

    // =========================================================================
    // Block J: 用家真實見證渲染 (客觀真實，零膠囊標籤)
    // =========================================================================
    function renderBlockJ(testimonials) {
      const container = document.getElementById('block-j-testimonials');
      container.innerHTML = '';
      if (!testimonials || testimonials.length === 0) return;
      testimonials.forEach(t => {
        const item = document.createElement('div');
        item.style.background = 'var(--color-bg)';
        item.style.border = '1px solid var(--color-border)';
        item.style.borderRadius = 'var(--radius-lg)';
        item.style.padding = '18px 20px';
        item.innerHTML = `
          <div style="margin-bottom: 8px;">
            <span style="font-weight: 800; font-size: 16px; color: var(--color-primary);">${t.name}（${t.age} · ${t.role}）</span>
          </div>
          <p style="font-size: 14.5px; color: var(--color-text-muted); margin-bottom: 4px;"><strong>原本困擾：</strong>${t.issue}</p>
          <p style="font-size: 14.5px; color: var(--color-text-muted); margin-bottom: 8px;"><strong>調理方案：</strong>${t.solution}</p>
          <div style="background: var(--color-surface); border-left: 3px solid var(--color-accent); padding: 10px 14px; border-radius: 4px; color: var(--color-accent-text); font-weight: 600; font-size: 14.5px;">
            ${t.quote}
          </div>
        `;
        container.appendChild(item);
      });
    }

    // =========================================================================
    // 購物車核心結算引擎 (階梯最優配對 ✕ 雙軌下單)
    // =========================================================================
    function calcItemOptimalSpecialPrice(prod, qty) {
      if (qty <= 0) return { finalCost: 0, breakdownList: [] };
      let remaining = qty;
      let cost = 0;
      let breakdown = [];

      if (prod.packages && prod.packages.length > 0) {
        for (let p of prod.packages) {
          if (remaining >= p.qty) {
            let sets = Math.floor(remaining / p.qty);
            cost += sets * p.price;
            remaining = remaining % p.qty;
            breakdown.push({ code: p.code, name: p.name, sets: sets, totalUnits: sets * p.qty, cost: sets * p.price });
          }
        }
      }
      if (remaining > 0) {
        let singleUnitCost = prod.specialPrice || prod.price;
        cost += remaining * singleUnitCost;
        breakdown.push({ code: prod.id, name: "特別單件價", sets: remaining, totalUnits: remaining, cost: remaining * singleUnitCost });
      }
      return { finalCost: cost, breakdownList: breakdown };
    }

    function updateCart(key, delta, price, title) {
      if (!cart[key]) {
        cart[key] = { qty: 0, price: price, title: title };
      }
      cart[key].qty += delta;
      if (cart[key].qty < 0) cart[key].qty = 0;

      const valEl = document.getElementById('qty_' + key);
      if (valEl) valEl.innerText = cart[key].qty;

      recalculateCart();
    }

    function recalculateCart() {
      let hasBundle = false;
      let singleItemsCount = 0;
      let totalUnitsCount = 0;
      let referenceRetailTotal = 0; // 原價參考
      let hiddenSpecialSingleTotal = 0; // 隱藏單品特別優惠總額 (用於門檻檢測)
      let actualBundleCost = 0; // 套裝實收金額

      let singleItemsBreakdown = {};

      for (let k in cart) {
        const item = cart[k];
        if (item.qty <= 0) continue;
        totalUnitsCount += item.qty;

        if (k.startsWith('bun_')) {
          hasBundle = true;
          const bId = k.replace('bun_', '');
          const bundleObj = BUNDLES_DB.find(b => b.id === bId);
          if (bundleObj) {
            actualBundleCost += (bundleObj.price * item.qty);
            referenceRetailTotal += (bundleObj.origPrice * item.qty);
          } else {
            actualBundleCost += (item.price * item.qty);
            referenceRetailTotal += (item.price * item.qty);
          }
        } else if (k.startsWith('prod_')) {
          singleItemsCount += item.qty;
          const pId = k.replace('prod_', '');
          const prodObj = PRODUCTS_DB.find(p => p.id === pId);
          if (prodObj) {
            referenceRetailTotal += (prodObj.price * item.qty);
            const optimal = calcItemOptimalSpecialPrice(prodObj, item.qty);
            hiddenSpecialSingleTotal += optimal.finalCost;
            singleItemsBreakdown[pId] = optimal;
          } else {
            referenceRetailTotal += (item.price * item.qty);
            hiddenSpecialSingleTotal += (item.price * item.qty);
          }
        }
      }

      if (totalUnitsCount === 0) {
        document.getElementById('cart-summary-items').innerHTML = '購物車目前為空';
        document.getElementById('cart-subtotal').innerText = 'HKD 0';
        document.getElementById('cart-shipping').innerText = 'HKD 0';
        document.getElementById('cart-total').innerText = 'HKD 0';
        return;
      }

      // 特別優惠門檻判定：有選購30天套裝，或選購單品金額滿 HKD 1,200 即享特別折扣
      const isQualifiedForSpecialOffer = hasBundle || (referenceRetailTotal >= 1200) || (hiddenSpecialSingleTotal >= 1200);

      let finalGoodsSubtotal = 0;
      let summaryHtml = '';

      for (let k in cart) {
        const item = cart[k];
        if (item.qty <= 0) continue;

        if (k.startsWith('bun_')) {
          const bId = k.replace('bun_', '');
          const bObj = BUNDLES_DB.find(b => b.id === bId);
          const bPrice = bObj ? bObj.price : item.price;
          const bLineCost = bPrice * item.qty;
          finalGoodsSubtotal += bLineCost;
          summaryHtml += `
            <div class="summary-line">
              <span>${item.title} x ${item.qty}</span>
              <span style="font-weight: 700;">HKD ${bLineCost.toLocaleString()}</span>
            </div>
          `;
        } else if (k.startsWith('prod_')) {
          const pId = k.replace('prod_', '');
          const pObj = PRODUCTS_DB.find(p => p.id === pId);
          let pLineCost = 0;

          if (isQualifiedForSpecialOffer) {
            pLineCost = singleItemsBreakdown[pId] ? singleItemsBreakdown[pId].finalCost : (item.price * item.qty);
          } else {
            pLineCost = (pObj ? pObj.price : item.price) * item.qty;
          }
          finalGoodsSubtotal += pLineCost;
          summaryHtml += `
            <div class="summary-line">
              <span>${item.title} x ${item.qty}</span>
              <span style="font-weight: 700;">HKD ${pLineCost.toLocaleString()}</span>
            </div>
          `;
        }
      }

      // 折扣與特別優惠狀態呈現 (零會員字眼，一律使用「特別優惠」)
      const savedAmount = referenceRetailTotal - finalGoodsSubtotal;
      let discountRateStr = "";
      if (referenceRetailTotal > 0 && savedAmount > 0) {
        const rate = Math.round((finalGoodsSubtotal / referenceRetailTotal) * 10);
        discountRateStr = rate < 10 ? `${rate}折` : "特別折";
      }

      let promoBannerHtml = '';
      if (isQualifiedForSpecialOffer && savedAmount > 0) {
        promoBannerHtml = `
          <div style="background: #CCFBF1; border-left: 4px solid var(--color-accent); border-radius: var(--radius-sm); padding: 9px 14px; margin-bottom: 12px; font-size: 14.5px; font-weight: 800; color: #115E59; display: flex; justify-content: space-between; align-items: center;">
            <span>✨ 已享特別優惠價</span>
            <span>已慳 HKD ${savedAmount.toLocaleString()} (${discountRateStr})</span>
          </div>
        `;
      } else if (!hasBundle && singleItemsCount > 0 && !isQualifiedForSpecialOffer) {
        promoBannerHtml = `
          <div style="background: #FFFBEB; border-left: 4px solid var(--color-warning); border-radius: var(--radius-sm); padding: 8px 12px; margin-bottom: 12px; font-size: 13.5px; color: #92400E; font-weight: 600;">
            💡 提示：單品選購滿 HKD 1,200 即自動啟動「特別優惠」！
          </div>
        `;
      }

      document.getElementById('cart-summary-items').innerHTML = promoBannerHtml + summaryHtml;

      // 顯示原價參考 vs 特別優惠應付金額
      if (savedAmount > 0) {
        document.getElementById('cart-subtotal').innerHTML = `
          <span style="text-decoration: line-through; color: var(--color-text-sub); font-size: 13.5px; margin-right: 6px;">HKD ${referenceRetailTotal.toLocaleString()}</span>
          <span style="color: var(--color-accent-text); font-weight: 800;">HKD ${finalGoodsSubtotal.toLocaleString()}</span>
        `;
      } else {
        document.getElementById('cart-subtotal').innerText = `HKD ${finalGoodsSubtotal.toLocaleString()}`;
      }

      let shipping = (finalGoodsSubtotal >= 400) ? 0 : 40;
      document.getElementById('cart-shipping').innerText = (shipping === 0) ? '免費 (滿額免運)' : `HKD ${shipping}`;
      document.getElementById('cart-total').innerText = `HKD ${(finalGoodsSubtotal + shipping).toLocaleString()}`;
    }

    function submitOrderDualTrack() {
      const name = document.getElementById('order_recipient_name').value.trim();
      const phone = document.getElementById('order_recipient_phone').value.trim();
      const address = document.getElementById('order_recipient_address').value.trim();
      const hasLift = document.getElementById('order_has_lift').checked;
      const paymentMethod = document.querySelector('input[name="order_payment"]:checked')?.value || document.querySelector('input[name="order_payment_method"]:checked')?.value || "FPS 轉數快";

      if (Object.keys(cart).length === 0) {
        alert('請先選取所需單品或調理套裝！');
        return;
      }
      if (!name || !phone || !address) {
        alert('請完整填寫收件人姓名、電話及詳細收貨地址！');
        return;
      }

      let hasBundle = false;
      let hiddenSpecialSingleTotal = 0;
      let referenceRetailTotal = 0;
      let singleItemsBreakdown = {};

      for (let k in cart) {
        const item = cart[k];
        if (item.qty <= 0) continue;
        if (k.startsWith('bun_')) {
          hasBundle = true;
          const bId = k.replace('bun_', '');
          const bObj = BUNDLES_DB.find(b => b.id === bId);
          referenceRetailTotal += (bObj ? bObj.origPrice : item.price) * item.qty;
        } else if (k.startsWith('prod_')) {
          const pId = k.replace('prod_', '');
          const pObj = PRODUCTS_DB.find(p => p.id === pId);
          if (pObj) {
            referenceRetailTotal += pObj.price * item.qty;
            const optimal = calcItemOptimalSpecialPrice(pObj, item.qty);
            hiddenSpecialSingleTotal += optimal.finalCost;
            singleItemsBreakdown[pId] = optimal;
          } else {
            referenceRetailTotal += item.price * item.qty;
            hiddenSpecialSingleTotal += item.price * item.qty;
          }
        }
      }

      const isQualifiedForSpecialOffer = hasBundle || (referenceRetailTotal >= 1200) || (hiddenSpecialSingleTotal >= 1200);

      let subtotal = 0;
      let customerOrderItems = [];
      let backendProcurementNotes = [];

      for (let k in cart) {
        const item = cart[k];
        if (item.qty <= 0) continue;

        if (k.startsWith('bun_')) {
          const bId = k.replace('bun_', '');
          const bObj = BUNDLES_DB.find(b => b.id === bId);
          const lineCost = (bObj ? bObj.price : item.price) * item.qty;
          subtotal += lineCost;
          customerOrderItems.push(`${item.title} x ${item.qty} (HKD ${lineCost.toLocaleString()})`);
          backendProcurementNotes.push(`套裝: ${item.title} x ${item.qty}`);
        } else if (k.startsWith('prod_')) {
          const pId = k.replace('prod_', '');
          const pObj = PRODUCTS_DB.find(p => p.id === pId);
          let lineCost = 0;
          if (isQualifiedForSpecialOffer && singleItemsBreakdown[pId]) {
            lineCost = singleItemsBreakdown[pId].finalCost;
            const bd = singleItemsBreakdown[pId].breakdownList;
            let bdTexts = bd.map(b => `${b.code} (${b.name}) x ${b.sets}`).join(', ');
            backendProcurementNotes.push(`${item.title} x ${item.qty} => [${bdTexts}] 計 HKD ${lineCost}`);
          } else {
            lineCost = (pObj ? pObj.price : item.price) * item.qty;
            backendProcurementNotes.push(`${item.title} x ${item.qty} (零售價計 HKD ${lineCost})`);
          }
          subtotal += lineCost;
          customerOrderItems.push(`${item.title} x ${item.qty} (HKD ${lineCost.toLocaleString()})`);
        }
      }

      let shipping = (subtotal >= 400) ? 0 : 40;
      let total = subtotal + shipping;
      let savedAmount = referenceRetailTotal - subtotal;
      let discountRateStr = "";
      if (referenceRetailTotal > 0 && savedAmount > 0) {
        const rate = Math.round((subtotal / referenceRetailTotal) * 10);
        discountRateStr = rate < 10 ? `${rate}折` : "特別折";
      }

      // 前端生成唯一標準訂單編號 HD-YYYYMMDD-XXXXXX
      const now = new Date();
      const dateStr = now.getFullYear().toString() +
        String(now.getMonth() + 1).padStart(2, '0') +
        String(now.getDate()).padStart(2, '0');
      const randomSix = Math.floor(100000 + Math.random() * 900000);
      const orderId = "HD-" + dateStr + "-" + randomSix;

      const orderData = {
        type: "order",
        orderId: orderId,
        topicName: TOPIC_CONFIG.topicName || "健康專題",
        timestamp: now.toISOString(),
        causeId: selectedCauseId,
        causeName: CAUSES_DATA[selectedCauseId].name,
        recipient: { name, phone, address, hasLift: hasLift ? "有升降機" : "無升降機（需行樓梯）" },
        paymentMethod: paymentMethod,
        items: customerOrderItems,
        subtotal: subtotal,
        shipping: shipping,
        total: total,
        referenceOriginalTotal: referenceRetailTotal,
        savedAmount: savedAmount > 0 ? savedAmount : 0,
        discountRate: discountRateStr,
        backendProcurementNote: backendProcurementNotes.join('; ')
      };

      // 軌道一：WhatsApp 對話喚起 (帶入付款方式與唯一訂單編號)
      const liftText = hasLift ? "有升降機" : "無升降機（唐樓需現場付樓梯費）";
      let discountLine = "";
      if (savedAmount > 0) {
        discountLine = `商品原價：HKD ${referenceRetailTotal.toLocaleString()}%0A` +
          `特別優惠價：HKD ${subtotal.toLocaleString()} (已慳 HKD ${savedAmount.toLocaleString()} / ${discountRateStr})%0A`;
      } else {
        discountLine = `商品小計：HKD ${subtotal.toLocaleString()}%0A`;
      }

      const waText = `【Health Decoder ${TOPIC_CONFIG.topicName || "專題"}訂單】%0A` +
        `訂單編號：${orderId}%0A` +
        `主診斷成因：${CAUSES_DATA[selectedCauseId].name}%0A` +
        `收件人：${encodeURIComponent(name)}%0A` +
        `聯絡電話：${encodeURIComponent(phone)}%0A` +
        `送貨地址：${encodeURIComponent(address)} (${encodeURIComponent(liftText)})%0A%0A` +
        `【訂購明細】%0A` +
        customerOrderItems.map(i => `• ${encodeURIComponent(i)}`).join('%0A') + `%0A%0A` +
        discountLine +
        `運費：${shipping === 0 ? "免費 (滿額免運)" : "HKD " + shipping}%0A` +
        `應付總額：HKD ${total.toLocaleString()}%0A` +
        `付款方式：${encodeURIComponent(paymentMethod)}%0A%0A` +
        `請 Duncan 盡快為我發送收款資料及確認訂單，謝謝！`;
      const waUrl = `https://wa.me/${DUNCAN_WHATSAPP_PHONE}?text=${waText}`;

      // 軌道二：Apps Script Webhook 異步記表
      if (APPS_SCRIPT_WEBHOOK_URL) {
        try {
          fetch(APPS_SCRIPT_WEBHOOK_URL, {
            method: 'POST',
            mode: 'no-cors',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(orderData)
          }).catch(err => console.log('Webhook logging:', err));
        } catch (e) {
          console.log('Webhook skip');
        }
      }

      window.open(waUrl, '_blank');
    }

    function openModalWithLock(title, contentHtml) {
      savedScrollY = window.scrollY || window.pageYOffset || document.documentElement.scrollTop;
      document.documentElement.style.overflow = 'hidden';
      document.body.style.overflow = 'hidden';
      document.getElementById('modalTitle').innerText = title;
      document.getElementById('modalContent').innerHTML = contentHtml;
      document.getElementById('globalModal').style.display = 'flex';
    }

    function closeModal() {
      document.getElementById('globalModal').style.display = 'none';
      document.documentElement.style.overflow = '';
      document.body.style.overflow = '';
      const prevBehavior = document.documentElement.style.scrollBehavior;
      document.documentElement.style.scrollBehavior = 'auto';
      window.scrollTo(0, savedScrollY);
      document.documentElement.style.scrollBehavior = prevBehavior;
    }

    function handleModalBackdropClick(e) {
      if (e.target.id === 'globalModal') {
        closeModal();
      }
    }

    function switchGalleryImage(src) {
      const mainImg = document.getElementById('gallery-main-img');
      if (mainImg) mainImg.src = src;
    }


    // 全站共用圖庫 DNS 絕對路徑常數與自癒容錯引擎 (health-decoder.com)
    const SITE_DOMAIN_BASE = 'https://health-decoder.com';

    function getProductImgUrl(prodId) {
      return `${SITE_DOMAIN_BASE}/images/products/${prodId}.webp`;
    }

    function getBundleImgUrl(bundleId) {
      return `${SITE_DOMAIN_BASE}/images/packages/${bundleId}.webp`;
    }

    function handleImgFallback(imgEl, prodId, isPackage = false) {
      const folder = isPackage ? 'packages' : 'products';
      if (!imgEl.dataset.fbStep) {
        imgEl.dataset.fbStep = "1";
        imgEl.src = `/images/${folder}/${prodId}.webp`;
      } else if (imgEl.dataset.fbStep === "1") {
        imgEl.dataset.fbStep = "2";
        imgEl.src = `../images/${folder}/${prodId}.webp`;
      }
    }

    // Pop-up A: 產品詳情 (嚴格檢查產地，產地為空時絕不顯示「產地：」)
    function openProductModal(prodId) {
      const prod = PRODUCTS_DB.find(p => p.id === prodId);
      if (!prod) return;

      const mainImg = prod.img || getProductImgUrl(prod.id);

      let galleryHtml = `
        <div class="modal-white-image-box">
          <img id="gallery-main-img" src="${mainImg}" onerror="handleImgFallback(this, '${prod.id}', false)" alt="${prod.name}">
        </div>
      `;

      if (prod.id === '0368') {
        const d1 = prod.demoImg1 || `https://health-decoder.com/images/products/0368-demo1.webp`;
        const d2 = prod.demoImg2 || `https://health-decoder.com/images/products/0368-demo2.webp`;
        galleryHtml = `
          <div>
            <div class="modal-white-image-box">
              <img id="gallery-main-img" src="${mainImg}" onerror="handleImgFallback(this, '0368', false)" alt="${prod.name}">
            </div>
            <div class="gallery-thumbs">
              <button type="button" onclick="switchGalleryImage('${mainImg}')" class="gallery-thumb-btn">
                <img src="${mainImg}" onerror="handleImgFallback(this, '0368', false)">
              </button>
              <button type="button" onclick="switchGalleryImage('${d1}')" class="gallery-thumb-btn">
                <img src="${d1}" onerror="handleImgFallback(this, '0368-demo1', false)">
              </button>
              <button type="button" onclick="switchGalleryImage('${d2}')" class="gallery-thumb-btn">
                <img src="${d2}" onerror="handleImgFallback(this, '0368-demo2', false)">
              </button>
            </div>
          </div>
        `;
      }

      const prod = PRODUCTS_DB.find(p => p.id === prodId);
      if (!prod) return;

      let galleryHtml = `
        <div class="modal-white-image-box">
          <img id="gallery-main-img" src="${prod.img}" alt="${prod.name}">
        </div>
      `;

      if (prod.id === '0368') {
        galleryHtml = `
          <div>
            <div class="modal-white-image-box">
              <img id="gallery-main-img" src="${prod.img}" alt="${prod.name}">
            </div>
            <div class="gallery-thumbs">
              <button type="button" onclick="switchGalleryImage('${prod.img}')" class="gallery-thumb-btn">
                <img src="${prod.img}">
              </button>
              <button type="button" onclick="switchGalleryImage('${prod.demoImg1}')" class="gallery-thumb-btn">
                <img src="${prod.demoImg1}">
              </button>
              <button type="button" onclick="switchGalleryImage('${prod.demoImg2}')" class="gallery-thumb-btn">
                <img src="${prod.demoImg2}">
              </button>
            </div>
          </div>
        `;
      }

      const html = `
        <div>
          ${galleryHtml}
          <div style="margin-top: 14px;">
            <div style="margin-bottom: 6px;"><span style="font-weight: 700; color: #FFF;">規格/總件數：</span>${prod.spec}</div>
            ${prod.origin ? `<div style="margin-bottom: 6px;"><span style="font-weight: 700; color: #FFF;">產地：</span>${prod.origin}</div>` : ''}
            ${prod.warranty ? `<div style="margin-bottom: 6px;"><span style="font-weight: 700; color: #D4A343;">原廠保養：</span><span style="color: #FFFFFF;">${prod.warranty}</span></div>` : ''}
            <div style="border-top: 1px solid #374151; padding-top: 10px; margin-top: 10px;">
              <span style="font-weight: 800; color: #D4A343; display: block; margin-bottom: 4px;">主要功效：</span>
              <span style="color: #CBD5E1; line-height: 1.65;">${prod.intro}</span>
            </div>
            <div style="border-top: 1px solid #374151; padding-top: 10px; margin-top: 10px;">
              <span style="font-weight: 800; color: #D4A343; display: block; margin-bottom: 4px;">產品適合對象：</span>
              <span style="color: #CBD5E1; line-height: 1.65;">${prod.target}</span>
            </div>
            <div style="border-top: 1px solid #374151; padding-top: 10px; margin-top: 10px;">
              <span style="font-weight: 800; color: #D4A343; display: block; margin-bottom: 4px;">成份與技術：</span>
              <span style="color: #CBD5E1; line-height: 1.65;">${prod.ingredients}</span>
            </div>
            <div style="border-top: 1px solid #374151; padding-top: 10px; margin-top: 10px;">
              <span style="font-weight: 800; color: #D4A343; display: block; margin-bottom: 4px;">建議使用方法：</span>
              <span style="color: #CBD5E1; line-height: 1.65;">${prod.usage}</span>
            </div>
            <div style="border-top: 1px solid #374151; padding-top: 10px; margin-top: 10px;">
              <span style="font-weight: 800; color: #D4A343; display: block; margin-bottom: 4px;">注意事項：</span>
              <span style="color: #CBD5E1; line-height: 1.65;">${prod.warning}</span>
            </div>
          </div>
        </div>
      `;
      openModalWithLock(prod.name, html);
    }

    // 彈窗 B：夜尿專屬修復原理 (600x600 圖片 ＋ 5大成因總名稱分類生化機轉，零價格零折扣)
    function openMechanismModal(prodId, causeId) {
      const prod = PRODUCTS_DB.find(p => p.id === prodId);
      if (!prod) return;

      const originHtml = (prod.origin && prod.origin.trim() !== "") ? `<div style="margin-bottom: 6px;"><span style="font-weight: 700; color: #FFF;">產地：</span>${prod.origin}</div>` : '';
      const warrantyHtml = (prod.warranty && prod.warranty.trim() !== "") ? `<div style="margin-bottom: 6px;"><span style="font-weight: 700; color: #D4A343;">原廠保養：</span><span style="color: #FFFFFF;">${prod.warranty}</span></div>` : '';

      const html = `
        <div>
          <div class="modal-white-image-box">
            <img src="${prod.img || getProductImgUrl(prod.id)}" onerror="handleImgFallback(this, '${prod.id}', false)" alt="${prod.name}">
          </div>
          <div style="margin-top: 14px;">
            <div style="margin-bottom: 6px;"><span style="font-weight: 700; color: #FFF;">規格/總件數：</span>${prod.spec || '1件裝'}</div>
            ${originHtml}
            ${warrantyHtml}
            <div style="border-top: 1px solid #374151; padding-top: 10px; margin-top: 10px;">
              <span style="font-weight: 800; color: #D4A343; display: block; margin-bottom: 4px;">本成因調理機轉：</span>
              <p style="color: #CBD5E1; line-height: 1.65;">${prod.intro || ''}</p>
            </div>
          </div>
        </div>
      `;
      openModalWithLock(`${prod.name} · 調理機轉`, html);
    }

    // Pop-up B: 30天套裝明細彈窗 (完整呈現套裝所含單品與機轉)
    function openBundleModal(bundleId) {
      const bundle = BUNDLES_DB.find(b => b.id === bundleId);
      if (!bundle) return;

      const html = `
        <div>
          <div class="modal-white-image-box">
            <img src="${bundle.img || getBundleImgUrl(bundle.id)}" onerror="handleImgFallback(this, '${bundle.id}', true)" alt="${bundle.name}">
          </div>
          <div style="margin-top: 14px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
              <span style="font-weight: 800; font-size: 17px; color: #FFF;">${bundle.name}</span>
              <span style="font-size: 12px; background: #064E3B; color: #34D399; padding: 2px 8px; border-radius: 4px; font-weight: 700; border: 1px solid #059669;">30 天完整調理份量</span>
            </div>
            ${bundle.isWarfarinSafe ? '<div style="background: rgba(120, 53, 15, 0.4); border: 1px solid #D97706; color: #FDE68A; padding: 6px 10px; border-radius: 6px; font-weight: 700; font-size: 13px; margin-bottom: 10px;">【適合薄血藥用家】</div>' : ''}
            <div style="border-top: 1px solid #374151; padding-top: 10px; margin-top: 10px;">
              <span style="font-weight: 800; color: #D4A343; display: block; margin-bottom: 4px;">內含完整單品組合：</span>
              <p style="color: #E2E8F0; line-height: 1.65;">${bundle.itemsSummary || ''}</p>
            </div>
            <div style="border-top: 1px solid #374151; padding-top: 10px; margin-top: 10px;">
              <span style="font-weight: 800; color: #D4A343; display: block; margin-bottom: 4px;">30 天協同調理機轉：</span>
              <p style="color: #CBD5E1; line-height: 1.65;">${bundle.desc || ''}</p>
            </div>
          </div>
        </div>
      `;
      openModalWithLock(`${bundle.name} · 套裝明細`, html);
    }

    // Block K: 11 級逆向向上平滑導航狀態機
    function handleElevatorUp() {
      const isGatedUnlocked = document.getElementById("gated-content").style.display === "block";
      const sectionSequence = isGatedUnlocked
        ? ["blockA", "blockC", "blockD", "blockE", "blockF", "blockG", "blockH", "blockJ", "blockM", "blockL", "blockI"]
        : ["blockA", "blockB"];
      const scrollPos = window.scrollY + 120;
      let targetSection = sectionSequence[0];
      for (let i = sectionSequence.length - 1; i >= 0; i--) {
        const el = document.getElementById(sectionSequence[i]);
        if (el && el.offsetTop < scrollPos) {
          if (i > 0) {
            targetSection = sectionSequence[i - 1];
          } else {
            targetSection = sectionSequence[0];
          }
          break;
        }
      }
      const targetEl = document.getElementById(targetSection);
      if (targetEl) {
        targetEl.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    }
  </script>
</body>
</html>
