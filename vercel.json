{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/health-intake.js": {
      "includeFiles": "server/{schema.sql,tracker-preview.html,tracker-preview.mjs}",
      "maxDuration": 30
    },
    "api/report-pdf.js": {
      "includeFiles": "server/fonts/*.otf",
      "maxDuration": 30
    },
    "api/report-v2-pdf.js": {
      "includeFiles": "server/fonts/*.otf",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/health-intake/:path*",
      "destination": "/api/health-intake?route=:path*"
    }
  ],
  "headers": [
    {
      "source": "/intake",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/intake/",
      "headers": [
        {
          "key": "Cache-Control",
